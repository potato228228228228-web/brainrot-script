    TabButton.TextSize = 14
    TabButton.Text = name
    
    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(0, 6)
    BtnCorner.Parent = TabButton
    
    -- Страница контента
    local Page = Instance.new("ScrollingFrame")
    Page.Name = name .. "Page"
    Page.Parent = PagesContainer
    Page.BackgroundTransparency = 1
    Page.Position = UDim2.new(0, 150, 0, 50)
    Page.Size = UDim2.new(1, -160, 1, -60)
    Page.CanvasSize = UDim2.new(0, 0, 2, 0)
    Page.ScrollBarThickness = 3
    Page.Visible = (TabsCount == 1) -- Первая вкладка открыта по умолчанию
    
    if TabsCount == 1 then
        TabButton.TextColor3 = Color3.fromRGB(255, 255, 255)
        TabButton.BackgroundColor3 = Color3.fromRGB(120, 0, 255)
    end
    
    local PageLayout = Instance.new("UIListLayout")
    PageLayout.Parent = Page
    PageLayout.SortOrder = Enum.SortOrder.LayoutOrder
    PageLayout.Padding = UDim.new(0, 10)
    
    -- Переключение вкладок
    TabButton.MouseButton1Click:Connect(function()
        for _, p in pairs(PagesContainer:GetChildren()) do
            p.Visible = false
        end
        for _, b in pairs(Sidebar:GetChildren()) do
            if b:IsA("TextButton") then
                b.TextColor3 = Color3.fromRGB(180, 180, 180)
                b.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
            end
        end
        Page.Visible = true
        TabButton.TextColor3 = Color3.fromRGB(255, 255, 255)
        TabButton.BackgroundColor3 = Color3.fromRGB(120, 0, 255)
    end)
    
    return Page
end

