            if espActive then
                if not p.Character:FindFirstChild("XenHighlight") then
                    local hl = Instance.new("Highlight")
                    hl.Name = "XenHighlight"
                    hl.FillColor = Color3.fromRGB(120, 0, 255)
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                    hl.Parent = p.Character
                end
            else
                if p.Character:FindFirstChild("XenHighlight") then
                    p.Character.XenHighlight:Destroy()
                end
            end
        end
    end
end)

